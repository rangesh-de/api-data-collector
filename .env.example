# Copy this file to .env and fill in your keys. .env is in .gitignore, so it is never committed.

# Required for job postings: free key from https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: Reddit source switches on only when these are set
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=api-data-collector/1.0 (by u/your_reddit_username)

# Optional: where the SQLite database lives (default: data/collector.db)
# COLLECTOR_DB=data/collector.db
